FROM python:3.11-slim
LABEL org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY contracts/python /deps/contracts/python
COPY services/ucp-connector/pyproject.toml .
COPY services/ucp-connector/src/ ./src/

RUN pip install --upgrade pip setuptools wheel
RUN pip install /deps/contracts/python .

ENV PYTHONPATH=/app/src
ENV MCP_TRANSPORT=sse
ENV PORT=8084
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "talos_ucp_connector.adapters.inbound.mcp_server"]
